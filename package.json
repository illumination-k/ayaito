{
  "name": "ayaito",
  "version": "0.1.1",
  "description": "A small engine for building typed agent workflows as graphs on the Claude Agent SDK.",
  "keywords": [
    "agent",
    "claude",
    "claude-agent-sdk",
    "graph",
    "llm",
    "workflow"
  ],
  "homepage": "https://github.com/illumination-k/ayaito#readme",
  "bugs": {
    "url": "https://github.com/illumination-k/ayaito/issues"
  },
  "license": "MIT",
  "author": "illumination-k",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illumination-k/ayaito.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.309 <0.4",
    "zod": "^4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
