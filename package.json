{
  "name": "ayaito",
  "version": "0.2.0",
  "description": "A small engine for building typed agent workflows as graphs, on Claude, Codex or opencode.",
  "keywords": [
    "agent",
    "claude",
    "claude-agent-sdk",
    "codex",
    "graph",
    "llm",
    "opencode",
    "workflow"
  ],
  "homepage": "https://github.com/illumination-k/ayaito#readme",
  "bugs": {
    "url": "https://github.com/illumination-k/ayaito/issues"
  },
  "license": "MIT",
  "author": "illumination-k",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illumination-k/ayaito.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./claude": "./dist/claude.mjs",
    "./codex": "./dist/codex.mjs",
    "./opencode": "./dist/opencode.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@openai/codex-sdk": "^0.169.0",
    "@opencode-ai/sdk": "^1.19.5",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.309 <0.4",
    "@openai/codex-sdk": ">=0.169.0 <0.170",
    "@opencode-ai/sdk": "^1.19.5"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
